# =============================================================================
# FRONTEND (public, aman masuk bundle browser) — isi di .env.local
# =============================================================================
# Ambil dari Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Opsional: paksa mode demo offline walaupun kredensial di atas sudah valid.
# Hapus atau set false untuk memakai backend Supabase sungguhan.
VITE_DEMO_MODE=false

# Origin frontend yang diizinkan oleh Edge Functions (dipakai di sisi server).
APP_ORIGIN=http://localhost:5173

# =============================================================================
# EDGE FUNCTION SECRETS (JANGAN pakai prefix VITE_, jangan commit)
# Set via: npx supabase secrets set --env-file supabase/.env
# =============================================================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SUPABASE_FUNCTION_SECRETS

# Midtrans Core API (sandbox: MIDTRANS_IS_PRODUCTION=false)
MIDTRANS_SERVER_KEY=SET_IN_SUPABASE_FUNCTION_SECRETS
MIDTRANS_IS_PRODUCTION=false
QRIS_EXPIRY_MINUTES=10

# Supplier (default 5sim). Butuh saldo dan pemetaan ID yang sudah diuji.
SUPPLIER_PROVIDER=5sim
SUPPLIER_API_KEY=SET_IN_SUPABASE_FUNCTION_SECRETS
SUPPLIER_BASE_URL=https://5sim.net/v1
SUPPLIER_CURRENCY_TO_IDR=16000
SUPPLIER_MIN_BALANCE_IDR=500000
SELLER_MARGIN_BPS=2000

# Wajib diisi agar katalog live tidak kosong. Contoh:
# [{"serviceId":"telegram","serviceName":"Telegram","countryCode":"indonesia","countryName":"Indonesia"}]
CATALOG_PAIRS_JSON=[]

# Opsional adapter SMS-Activate
# SMS_ACTIVATE_API_KEY=SET_IN_SUPABASE_FUNCTION_SECRETS
# SMS_ACTIVATE_CURRENCY_TO_IDR=16000
